<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Redirect plain HTTP to HTTPS. Temporary == 307, which preserves the
             method and body: the install runs with <usessl>false</usessl>, so AMP
             still emits http:// links and form actions, and a 301/302 here would
             silently downgrade every POST to a GET. Flipping the install to
             usessl=true removes this hop entirely. -->
        <rule name="amp-http-to-https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Temporary" appendQueryString="true" />
        </rule>
        <rule name="amp-proxy-https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^ON$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_SSL_ENABLED" value="1" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8111/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
